# These three create the first ops account on first boot (when the users
# table is empty). After that, sign in as this account and add teammates
# from Settings > Team — these variables are only read once and can be
# removed afterward.
INITIAL_ADMIN_EMAIL=you@yourcompany.com
INITIAL_ADMIN_NAME=Your Name
INITIAL_ADMIN_PASSWORD=change-me-now

# Secret used to sign session cookies. Set this to a long random string in production.
SESSION_SECRET=change-me-too

# Port the server listens on.
PORT=3000

# Only needed to connect Constant Contact (Settings > Constant Contact).
# Must be the real public HTTPS URL this app is deployed at — Constant
# Contact's OAuth flow will not redirect to localhost. Each Constant Contact
# account's Client ID/Secret is entered per-connection in Settings, not here
# — see the README for why (each account needs its own developer-portal app).
APP_BASE_URL=https://your-app.fly.dev
